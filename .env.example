# Copie este arquivo para .env e preencha os valores reais
# O arquivo .env NUNCA deve ser commitado no git

JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

TELEGRAM_BOT_TOKEN=token_do_botfather
TELEGRAM_ADMIN_CHAT_ID=seu_chat_id

# Chave da API OpenAI — necessária para leitura de cardápio e notas fiscais por IA
OPENAI_API_KEY=sk-...
# Modelo OpenAI a usar (padrão: gpt-4.1-mini)
OPENAI_MENU_IMPORT_MODEL=gpt-4.1-mini
# Modelo com visão para leitura de imagens do cardápio (padrão: gpt-4o-mini)
OPENAI_VISION_MODEL=gpt-4o-mini

# Opcional: restringe CORS a domínios específicos em produção
# ALLOWED_ORIGINS=https://seudominio.com.br
